---
import { getCollection } from "astro:content";
import GitHubContributionCalendar from "../components/GitHubContributionCalendar.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { feedItems } from "../data/feed";
import { getGitHubContributions } from "../lib/githubContributions";
import { formatEntryDate, selectFeaturedThenLatest } from "../lib/contentMeta";
import { formatFeedDate, renderFeedMarkdown, sortFeedItems } from "../lib/feed";
import SiteLayout from "../layouts/SiteLayout.astro";

const githubContributions = await getGitHubContributions({
  cacheSeconds: Number(import.meta.env.GITHUB_CONTRIBUTIONS_CACHE_SECONDS ?? 1800),
  login: import.meta.env.GITHUB_LOGIN,
  token: import.meta.env.GITHUB_TOKEN
});
const homeNotes = selectFeaturedThenLatest(await getCollection("notes"), 3);
const homeArtifacts = selectFeaturedThenLatest(await getCollection("artifacts"), 3);
const homeExperiments = selectFeaturedThenLatest(
  (await getCollection("experiments")).filter((entry) => entry.data.homePreview?.enabled),
  3
);
const homeFeedItems = sortFeedItems(feedItems);
const previewModeClasses = {
  "ascii-reveal": "micro-mode-ascii",
  "color-cluster": "micro-mode-cluster",
  "outline-repel": "micro-mode-outline"
};
---

<SiteLayout
  home
  title="Nyan Matt Lab - Design Exploration"
  description="Astro, React, MDX design exploration for an AI-centric personal site."
>
  <div class="page-abstract is-asset" aria-hidden="true">
  </div>

  <main class="site-shell">
    <SiteHeader />

    <section class="hero">
      <div class="hero-copy">
        
        <h1 data-text="Designer specializing in design systems, engineering, and AI-assisted workflows.">Designer specializing in design systems, engineering, and AI-assisted workflows.</h1>
        <p>
          Exploration space for product design, front-end engineering, and AI development. 
          
        </p>
      </div>
      <aside class="hero-feed reveal-on-scroll reveal-delay-1" data-reveal aria-label="Scrollable site feed">
        <div class="feed-head">
          <p class="panel-kicker"><span>feed</span><span>current transmissions</span></p>
          <strong>scroll</strong>
        </div>
        <div class="feed-scroll" data-feed-scroll>
          {homeFeedItems.map((item) => (
            <article>
              <span>{formatFeedDate(item.date)}</span>
              <h2>
                {item.href ? <a href={item.href}>{item.title}</a> : item.title}
              </h2>
              {item.body && <p set:html={renderFeedMarkdown(item.body)} />}
            </article>
          ))}
        </div>
      </aside>
    </section>

    <section class="section-band" id="collections">
      
      <section class="home-panel-grid" aria-label="Site collection overview">
        <article class="home-panel home-panel-notes reveal-on-scroll reveal-delay-2" data-reveal>
          <div class="home-panel-preview">
            <div class="home-panel-intro">
              <div>
                <h2>Notes</h2>
                <p>
                  Ideas and informal thoughts.
                </p>
              </div>
            </div>

            <div class="home-entry-list" aria-label="Recent notes">
              {homeNotes.map((entry) => (
                <article class="home-entry">
                  <span>{formatEntryDate(entry.data.date)}</span>
                  <a href={`/notes/${entry.slug}/`} class="home-entry-link">{entry.data.title}</a>
                  {entry.data.subtitle && <p>{entry.data.subtitle}</p>}
                  {entry.data.tags.length > 0 && (
                    <div class="content-tags">
                      {entry.data.tags.map((tag) => <small>{tag}</small>)}
                    </div>
                  )}
                </article>
              ))}
            </div>
          </div>
        </article>

        <article class="home-panel home-panel-experiments reveal-on-scroll reveal-delay-3" data-reveal>
          <div class="home-panel-preview">
            <div class="home-panel-intro">
              <div>
                <h2>Experiments</h2>
                <p>
                  Studies, demos, and one-off tools.
                </p>
              </div>
            </div>

            <div class="experiment-micro-list">
              {homeExperiments.map((entry) => {
                const preview = entry.data.homePreview;
                if (!preview) return null;

                const [accentR, accentG, accentB] = preview.accent;

                return (
                  <a
                    class={`experiment-micro-card ${previewModeClasses[preview.mode]}`}
                    href={`/experiments/${entry.slug}/`}
                    data-experiment-preview
                    data-mode={preview.mode}
                    data-shape={preview.shape}
                    data-label={preview.label}
                    data-accent-r={accentR}
                    data-accent-g={accentG}
                    data-accent-b={accentB}
                  >
                    <div class="experiment-micro-viz" aria-hidden="true">
                      <canvas class="experiment-canvas" data-experiment-canvas></canvas>
                    </div>
                    <div class="experiment-micro-meta">
                      <span>{preview.kicker ?? entry.data.tags.slice(0, 2).join(" / ")}</span>
                      <strong>{entry.data.title}</strong>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        </article>

        <article class="home-panel home-panel-artifacts reveal-on-scroll reveal-delay-4" data-reveal>
          <div class="home-panel-preview">
            <div class="home-panel-intro">
              <div>
                <h2>Artifacts</h2>
                <p>
                  Junk drawer with links.
                </p>
              </div>
            </div>

            <div class="home-entry-list" aria-label="Recent artifacts">
              {homeArtifacts.map((entry) => (
                <article class="home-entry">
                  <span>{formatEntryDate(entry.data.date)}</span>
                  <a href={`/artifacts/${entry.slug}/`} class="home-entry-link">{entry.data.title}</a>
                  {entry.data.subtitle && <p>{entry.data.subtitle}</p>}
                </article>
              ))}
            </div>

            <div class="home-note-grid">
              <p><a href="https://tokenlink.app">TokenLink.app</a></p>
              <p><a href="https://www.figma.com/community/file/1140650660591704827">Nyan UI kit v2</a></p>
              <p><a href="https://github.com/nyan-matt">Github</a></p>
              <p><a href="https://www.linkedin.com/in/mattrea/">LinkedIn</a></p>
            </div>
          </div>
        </article>
      </section>
    </section>

    <GitHubContributionCalendar result={githubContributions} />

    <section class="content-map reveal-on-scroll reveal-delay-2" data-reveal>
      <div>
        <h2>More pages</h2>
      </div>
      <div class="map-grid">
        <a href="#" onclick="alert('Stub page link'); return false;">
          <span>01</span>
          <strong>About</strong>
          <p>Boring stuff.</p>
        </a>
        <a href="#" onclick="alert('Stub page link'); return false;">
          <span>02</span>
          <strong>Hire</strong>
          <p>Project work?</p>
        </a>
        <a href="#" onclick="alert('Stub page link'); return false;">
          <span>03</span>
          <strong>Contact</strong>
          <p>Get in touch.</p>
        </a>
      </div>
    </section>
  </main>
</SiteLayout>

<script>
  import "../scripts/experimentCanvases";
  const feedScroll = document.querySelector("[data-feed-scroll]");
  const feedDateFormatter = new Intl.DateTimeFormat("en", {
    day: "2-digit",
    hour: "2-digit",
    hour12: false,
    minute: "2-digit",
    month: "2-digit"
  });

  function escapeFeedHtml(value) {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");
  }

  function isSafeFeedHref(href) {
    return href.startsWith("/") || href.startsWith("https://") || href.startsWith("http://");
  }

  function renderFeedBody(value) {
    const escaped = escapeFeedHtml(value);

    return escaped.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label, href) => {
      if (!isSafeFeedHref(href)) return label;

      return `<a href="${href}">${label}</a>`;
    });
  }

  function formatFeedItemDate(value) {
    return feedDateFormatter.format(new Date(value)).replace(",", " -");
  }

  function isFeedItem(value) {
    return value
      && typeof value.id === "string"
      && typeof value.date === "string"
      && typeof value.title === "string";
  }

  function renderFeedItems(items) {
    if (!feedScroll || items.length === 0) return;

    feedScroll.replaceChildren(...items.map((item) => {
      const article = document.createElement("article");
      const meta = document.createElement("span");
      const title = document.createElement("h2");

      meta.textContent = formatFeedItemDate(item.date);

      if (item.href) {
        const link = document.createElement("a");
        link.href = item.href;
        link.textContent = item.title;
        title.append(link);
      } else {
        title.textContent = item.title;
      }

      article.append(meta, title);

      if (item.body) {
        const body = document.createElement("p");
        body.innerHTML = renderFeedBody(item.body);
        article.append(body);
      }

      return article;
    }));
  }

  async function refreshFeed() {
    if (!feedScroll) return;

    try {
      const response = await fetch("/.netlify/functions/feed", {
        headers: { accept: "application/json" }
      });
      if (!response.ok) return;

      const payload = await response.json();
      if (!payload || !Array.isArray(payload.items)) return;

      renderFeedItems(payload.items.filter(isFeedItem));
    } catch {
      // The build-time feed is the fallback when the live function is unavailable.
    }
  }

  refreshFeed();

  const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
  const reduceMotion = motionPreference.matches;
  const revealItems = document.querySelectorAll("[data-reveal]");

  if (revealItems.length) {
    if (reduceMotion || !("IntersectionObserver" in window)) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      }, {
        rootMargin: "0px 0px -12% 0px",
        threshold: 0.14
      });

      revealItems.forEach((item) => {
        item.classList.add("is-reveal-pending");
        revealObserver.observe(item);
      });
    }
  }


</script>
