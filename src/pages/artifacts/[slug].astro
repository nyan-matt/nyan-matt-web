---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { formatEntryDate } from "../../lib/contentMeta";

export async function getStaticPaths() {
  const artifacts = await getCollection("artifacts");
  return artifacts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<SiteLayout title={`${entry.data.title} - Artifacts - Nyan Matt Lab`} description={entry.data.subtitle}>
  <main class="mockup-page entry-page entry-artifact">
    <header class="mockup-topbar">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true"></span>
        <span>Nyan Matt</span>
      </a>
      <nav aria-label="Primary">
        <a href="/notes/">Notes</a>
        <a href="/experiments/">Experiments</a>
        <a href="/artifacts/">Artifacts</a>
      </nav>
    </header>

    <article class="entry-shell entry-shell-artifact">
      <header class="entry-terminal-hero">
        <div>
          <a class="text-link" href="/artifacts/">back to artifacts</a>
          <p class="eyebrow">Last updated {formatEntryDate(entry.data.date)}</p>
          <h1>{entry.data.title}</h1>
          {entry.data.subtitle && <p class="entry-subtitle">{entry.data.subtitle}</p>}
        </div>
      </header>
      <div class="entry-body entry-body-terminal">
        <div class="content-tags">
          {entry.data.tags.map((tag) => <small>{tag}</small>)}
        </div>
        <Content />
      </div>
    </article>
  </main>
</SiteLayout>
