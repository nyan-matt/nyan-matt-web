---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Nyan Matt Lab",
  description = "A working notebook for AI experiments, posts, and umbrella projects."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
