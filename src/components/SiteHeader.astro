---
type NavItem = {
  href: string;
  label: string;
  section: string;
};

const navItems: NavItem[] = [
  { href: "/notes/", label: "Notes", section: "notes" },
  { href: "/experiments/", label: "Experiments", section: "experiments" },
  { href: "/artifacts/", label: "Artifacts", section: "artifacts" }
];

const pathname = Astro.url.pathname;
const activeSection = navItems.find((item) => {
  const hrefWithoutTrailingSlash = item.href.replace(/\/$/, "");
  return pathname === hrefWithoutTrailingSlash || pathname.startsWith(item.href);
})?.section;
---

<header class="topbar">
  <a class="brand" href="/">
    <span class="brand-mark" aria-hidden="true">
      <img src="/assets/pop-tart.png" alt="" />
    </span>
    <span>Nyan Matt</span>
  </a>
  <div class="site-menu" data-site-menu>
    <button class="site-menu-toggle" type="button" aria-expanded="false" aria-label="Toggle primary navigation" data-site-menu-toggle>
      <span>Menu</span>
      <i aria-hidden="true"></i>
    </button>
    <nav aria-label="Primary" data-site-menu-nav>
      {navItems.map((item) => (
        <a
          class:list={[{ "is-active": activeSection === item.section }]}
          href={item.href}
          aria-current={activeSection === item.section ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  document.querySelectorAll("[data-site-menu]").forEach((menu) => {
    const toggle = menu.querySelector("[data-site-menu-toggle]");
    const nav = menu.querySelector("[data-site-menu-nav]");
    if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;

    toggle.addEventListener("click", () => {
      const isOpen = menu.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(isOpen));
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  });
</script>
