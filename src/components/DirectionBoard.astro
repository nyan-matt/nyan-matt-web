---
const { directions } = Astro.props;
---

<section class="direction-board" aria-label="Design direction comparison">
  {directions.map((direction) => {
    const previewItems = direction.sections.slice(0, 3);
    return (
      <article class={`direction-option theme-${direction.theme}`}>
        <div class="direction-option-head">
          <p class="panel-kicker"><span>{direction.number}</span><span>{direction.vibe}</span></p>
          <a class="text-link" href={direction.href ?? `/mockups/${direction.slug}/`}>
            {direction.cta ?? "open full mockup"}
          </a>
        </div>

        <div class={`board-preview theme-${direction.theme} board-${direction.theme}`}>
          <div class="board-main">
            <div>
              <h2>{direction.title}</h2>
              <p>{direction.intro}</p>
            </div>
          </div>

          <div class={`direction-specimen specimen-${direction.theme}`} aria-hidden="true">
            {direction.theme === "terminal" && (
              <>
                <div class="specimen-terminal-main">
                  <span>tokens / traces / receipts</span>
                  <strong>6,480 -&gt; 1,360</strong>
                  <div class="specimen-pixels">
                    {Array.from({ length: 96 }).map((_, index) => (
                      <i style={`opacity: ${0.18 + ((index * 13) % 8) / 10}`} />
                    ))}
                  </div>
                </div>
                <div class="specimen-terminal-side">
                  {previewItems.map((item) => (
                    <p>{item.label} / {item.meta}</p>
                  ))}
                </div>
              </>
            )}

            {direction.theme === "notebook" && (
              <>
                <aside>
                  <span>margin</span>
                  <p>questions, citations, update trails, and quiet side notes.</p>
                </aside>
                <article>
                  <span>essay / public notebook</span>
                  <h3>Working notes first. Instruments second.</h3>
                  <p>Posts get a readable center column, with technical receipts tucked into the margins instead of becoming the whole room.</p>
                </article>
              </>
            )}

            {direction.theme === "atlas" && (
              <>
                {previewItems.map((item, index) => (
                  <article class={`specimen-artifact specimen-artifact-${index + 1}`}>
                    <span>{item.label}</span>
                    <strong>{item.title}</strong>
                  </article>
                ))}
                <div class="specimen-orbit">
                  <span></span><span></span><span></span>
                </div>
              </>
            )}
          </div>

          <div class="board-notes">
            {direction.notes.map((note) => (
              <p>{note}</p>
            ))}
          </div>
        </div>
      </article>
    );
  })}
</section>
