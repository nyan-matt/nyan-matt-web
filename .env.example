GITHUB_LOGIN=your-github-login
GITHUB_TOKEN=github_pat_or_classic_pat_here

# Optional: cache GitHub GraphQL responses locally during dev/build.
# Default is 1800 seconds.
GITHUB_CONTRIBUTIONS_CACHE_SECONDS=1800

# Optional: set to 1 only when you want to bypass the local cache.
# GITHUB_CONTRIBUTIONS_REFRESH=1
